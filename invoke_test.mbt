  for h in d.handles {
    assert_true(
      h.handle_type is @dex.MethodHandleKind::InvokeStatic,
      msg="fx-dyn 句柄全部 invoke-static",
    )
    assert_true(
      h.is_method_ref(),
      msg="invoke-static 句柄索引语义为 method_ids",
    )
  }
}

///|
/// method_handle@ 名字标注与 dexdump `Method handle #N` 对照。
test "fx-dyn method_handle 名字标注" {
  let d = @dex.parse(fixture_fx_dyn_dex())
  assert_eq(
    @dex.method_handle_name(d, 0),
    "invoke-static Lfx/dyn/FxDyn;->lambda$makeAdder$0(II)I",
    msg="句柄 0 = lambda$makeAdder$0",
  )
  assert_eq(
    @dex.method_handle_name(d, 2),
    "invoke-static Lfx/dyn/FxDyn;->staticTarget()V",
    msg="句柄 2 = staticTarget",
  )
  let meta = @dex.method_handle_name(d, 3)
  assert_true(
    meta.contains("Ljava/lang/invoke/LambdaMetafactory;->metafactory("),
    msg="句柄 3 = LambdaMetafactory.metafactory",
  )
}

///|
/// call_site@ 名字标注：bootstrap 句柄 / 链接名 / 链接类型 / 静态参数。
test "fx-dyn call_site 名字标注" {
  let d = @dex.parse(fixture_fx_dyn_dex())
  let s0 = @dex.call_site_name(d, 0)
  assert_true(s0.contains("call_site@0{"), msg="call site 前缀")
  assert_true(s0.contains("name=\"apply\""), msg="链接名 apply")
  assert_true(s0.contains("type=(I)Lfx/dyn/FxDyn$IntOp;"), msg="链接类型")
  assert_true(
    s0.contains("invoke-static Lfx/dyn/FxDyn;->lambda$makeAdder$0(II)I"),
    msg="静态参数含 method handle 标注",
  )
  let s1 = @dex.call_site_name(d, 1)
  assert_true(s1.contains("name=\"run\""), msg="call site 1 链接名 run")
  assert_true(
    s1.contains("type=()Ljava/lang/Runnable;"),
    msg="call site 1 链接类型",
  )
}

///|
/// 指令解码：0xFA/0xFB（invoke-polymorphic{,/range}）、0xFC/0xFD
/// （invoke-custom{,/range}）、0xFE（const-method-handle）操作数标注。
test "fx-dyn 指令解码：038+ 指令组操作数标注" {
  let d = @dex.parse(fixture_fx_dyn_dex())
  let mut poly = 0
  let mut custom = 0
  for i in 0..<d.methods.length() {
    match d.code(i) {
      None => ()
      Some(c) =>
        for insn in c.insns {
          match insn.opcode {
            0xfa => {
              poly = poly + 1
              assert_eq(
                insn.mnemonic,
                "invoke-polymorphic",
                msg="0xFA 助记符",
              )
              assert_eq(insn.operands.length(), 3, msg="0xFA 三个操作数")
              assert_true(
                insn.operands[2].contains("("),
                msg="0xFA proto 标注为签名",
              )
            }
            0xfb => {
              poly = poly + 1
              assert_eq(insn.mnemonic, "invoke-polymorphic/range")
            }
            0xfc => {
              custom = custom + 1
              assert_eq(insn.mnemonic, "invoke-custom", msg="0xFC 助记符")
              assert_eq(insn.operands.length(), 2, msg="0xFC 两个操作数")
              assert_true(
                insn.operands[1].contains("call_site@"),
                msg="0xFC call site 标注",
              )
            }
            0xfd => {
              custom = custom + 1
              assert_eq(insn.mnemonic, "invoke-custom/range")
            }
            _ => ()
          }
        }
    }
  }
  assert_true(poly >= 2, msg="fixture 含 invoke-polymorphic 指令")
  assert_true(custom >= 3, msg="fixture 含 invoke-custom 指令")
}

///|
/// 结构化视图：invoke-custom → IndexCallSite，resolve_ref_name 可解析。
test "fx-dyn 结构化操作数视图：IndexCallSite / IndexMethod" {
  let d = @dex.parse(fixture_fx_dyn_dex())
  let mut got_callsite = false
  let mut got_method = false
  for i in 0..<d.methods.length() {
    match d.code(i) {
      None => ()
      Some(c) =>
        for insn in c.insns {
          let ops = @dex.instruction_operands(insn)
          if insn.opcode == 0xfc {
            assert_true(
              ops.index_kind is @dex.IndexKind::IndexCallSite,
              msg="0xFC 结构化类别 = IndexCallSite",
            )
            let name = @dex.resolve_ref_name(d, ops.index_kind, ops.index)
            assert_true(
              name.contains("call_site@"),
              msg="resolve_ref_name 解析 call site",
            )
            got_callsite = true
          }
          if insn.opcode == 0xfa {
            assert_true(
              ops.index_kind is @dex.IndexKind::IndexMethod,
              msg="0xFA 结构化类别 = IndexMethod",
            )
            let nm = @dex.instruction_ref_name(d, insn)
            assert_true(
              nm is Some(_),
              msg="invoke-polymorphic 方法名可解析",
            )
            got_method = true
          }
        }
    }
  }
  assert_true(got_callsite, msg="至少一条 invoke-custom")
  assert_true(got_method, msg="至少一条 invoke-polymorphic")
}

///|
/// 错误路径：越界句柄/调用点/类型索引一律报 DexError，不 panic。
test "fx-dyn 错误路径：越界索引" {
  let d = @dex.parse(fixture_fx_dyn_dex())
  let mut got_handle = false
  ignore(@dex.method_handle_name(d, 99)) catch {
    @dex.DexError::InvalidIndex(@dex.TableKind::MethodHandle, idx) => {
      assert_eq(idx, 99)
      got_handle = true
    }
    _ => ()
  }
  assert_true(
    got_handle,
    msg="越界 method_handle 应报 InvalidIndex(MethodHandle)",
  )
  let mut got_site = false
  ignore(@dex.call_site_name(d, 99)) catch {
    @dex.DexError::InvalidIndex(@dex.TableKind::CallSiteId, idx) => {
      assert_eq(idx, 99)
      got_site = true
    }
    _ => ()
  }
  assert_true(got_site, msg="越界 call_site 应报 InvalidIndex(CallSiteId)")
  let mut got_proto = false
  ignore(@dex.proto_name(d, 999)) catch {
    @dex.DexError::InvalidIndex(@dex.TableKind::ProtoId, idx) => {
      assert_eq(idx, 999)
      got_proto = true
    }
    _ => ()
  }
  assert_true(got_proto, msg="越界 proto 应报 InvalidIndex(ProtoId)")
}

// WP-2 注解语义测试（R2 语义补全轮新增文件）。
//
// 覆盖：annotation_directory_item（class/field/method/parameter 四类）、
// annotation_set_item、annotation_item、encoded_annotation 与 encoded_value
// 全 16 类型解码（含数组/枚举/嵌套注解/NULL/FIELD/METHOD 与最小宽度编码）。
//
// 真实样本佐证（dexdump -d -a 逐值核对，dexdump 位于 D:\Android\Sdk\build-tools\35.0.0）：
//   1) AnnoSample.dex —— WP-2 自建：AnnoSample.java 经 javac 21 + d8 生成（受控，非第三方）；
//   2) tvshell-debug.classes.dex —— 受控 APK 提取（来源与 SHA-256 见 fixture 注释）。
// 程序化 fixture 仅用于 d8 不会生成的 VALUE_FIELD/VALUE_METHOD/窄宽/错误路径覆盖，
// 不冒充真实格式兼容性；真实语义一律以真实样本佐证。
//
// 本文件的 sem_ 系列辅助与 fixture 供 dex_sem_consts_test.mbt / dex_sem_operand_test.mbt
// 共用（MoonBit 黑盒测试文件共享同一命名空间，前缀避开既有 check/b_/fx_ 前缀）。

///|
/// assert_true 包装：msg 为可选标签参数。
fn sem_check(cond : Bool, msg? : StringView) -> Unit raise {
  match msg {
    Some(m) => assert_true(cond, msg=m)
    None => assert_true(cond)
  }
}

///|
/// assert_eq 包装：msg 为可选标签参数。
fn[T : Eq + Debug] sem_check_eq(a : T, b : T, msg? : String) -> Unit raise {
  match msg {
    Some(m) => assert_eq(a, b, msg=m)
    None => assert_eq(a, b)
  }
}

///|
/// 测试用字节流构造：小端写入。
fn sem_b_u8(arr : Array[Byte], v : Int32) -> Unit {
  arr.push((v & 0xff).to_byte())
}

///|
fn sem_b_u16(arr : Array[Byte], v : Int32) -> Unit {
  sem_b_u8(arr, v & 0xff)
  sem_b_u8(arr, (v >> 8) & 0xff)
}

///|
fn sem_b_u32(arr : Array[Byte], v : Int32) -> Unit {
  sem_b_u16(arr, v & 0xffff)
  sem_b_u16(arr, (v >> 16) & 0xffff)
}

///|
fn sem_b_uleb(arr : Array[Byte], value : Int32) -> Unit {
  let mut v = value
  let mut more = true
  while more {
    let mut b = v & 0x7f
    v = v >> 7
    if v != 0 {
      b = b | 0x80
    } else {
      more = false
    }
    sem_b_u8(arr, b)
  }
}

///|
fn sem_b_patch_u32(arr : Array[Byte], off : Int32, v : Int32) -> Unit {
  arr[off] = (v & 0xff).to_byte()
  arr[off + 1] = ((v >> 8) & 0xff).to_byte()
  arr[off + 2] = ((v >> 16) & 0xff).to_byte()
  arr[off + 3] = ((v >> 24) & 0xff).to_byte()
}

///|
fn sem_b_align4(arr : Array[Byte]) -> Unit {
  while arr.length() % 4 != 0 {
    sem_b_u8(arr, 0)
  }
}

///|
/// 测试侧 adler32（与解析器实现独立，交叉验证）。
fn sem_b_adler(arr : Array[Byte], start : Int32, end : Int32) -> Int32 {
  let mut a = 1
  let mut b = 0
  let mut i = start
  while i < end {
    a = a + arr[i].to_int()
    if a >= 65521 {
      a = a - 65521
    }
    b = b + a
    if b >= 65521 {
      b = b - 65521
    }
    i = i + 1
  }
  (b << 16) | a
}

///|
fn sem_b_fix_checksum(arr : Array[Byte]) -> Unit {
  sem_b_patch_u32(arr, 0x08, sem_b_adler(arr, 12, arr.length()))
}

///|
/// string_data_item：uleb128(utf16_size) + MUTF-8 + 0x00。
fn sem_b_str_item(arr : Array[Byte], s : String) -> Unit {
  sem_b_uleb(arr, s.length())
  for c in s.to_array() {
    let v = c.to_int()
    if v == 0 {
      sem_b_u8(arr, 0xc0)
      sem_b_u8(arr, 0x80)
    } else if v < 0x80 {
      sem_b_u8(arr, v)
    } else if v < 0x800 {
      sem_b_u8(arr, 0xc0 | (v >> 6))
      sem_b_u8(arr, 0x80 | (v & 0x3f))
    } else {
      sem_b_u8(arr, 0xe0 | (v >> 12))
      sem_b_u8(arr, 0x80 | ((v >> 6) & 0x3f))
      sem_b_u8(arr, 0x80 | (v & 0x3f))
    }
  }
  sem_b_u8(arr, 0)
}

///|
/// encoded_value 元素：uleb(name_idx) + format/payload 字节序列。
fn sem_val_bytes(
  arr : Array[Byte],
  name_idx : Int32,
  bytes : Array[Int32],
) -> Unit {
  sem_b_uleb(arr, name_idx)
  for b in bytes {
    sem_b_u8(arr, b)
  }
}

///|
/// 程序化 fixture 的关键偏移（错误路径补丁与 encoded_array 入口用）。
struct SemFixture {
  arr : Array[Byte]
  ann_a1_off : Int32
  ann_a1_e1_off : Int32
  ann_s1_off : Int32
  sv_off : Int32
}

///|
/// 程序化 fixture：含四类注解目录（VALUE_FIELD/METHOD/ENUM/NULL/嵌套/数组/
/// 窄宽/左对齐浮点全覆盖）、static_values 前缀省略语义与全格式指令流的单 DEX。
/// 字符串 37 / 类型 6 / 原型 2 / 字段 4 / 方法 3 / 类 2。
fn sem_build_dex() -> SemFixture {
  let strings = [
    "LTest;", "Ljava/lang/Object;", "V", "I", "LAnno;", "LKind;", "value", "kind",
    "f", "fld", "m", "n", "m2", "VAL", "bar", "foo", "Source.java", "a", "b", "e0",
    "e1", "e2", "e3", "e4", "e5", "e6", "e7", "e8", "e9", "e10", "e11", "e12", "e13",
    "e14", "e15", "x", "VI",
  ]
  let arr : Array[Byte] = []
  for _ in 0..<0x70 {
    sem_b_u8(arr, 0)
  }
  // magic "dex\n035\0"
  sem_b_patch_u32(arr, 0x00, 0x0a786564)
  sem_b_patch_u32(arr, 0x04, 0x00353330)
  for i in 0..<20 {
    arr[0x0C + i] = (0x22).to_byte()
  }
  sem_b_patch_u32(arr, 0x24, 0x70) // header_size
  sem_b_patch_u32(arr, 0x28, 0x12345678) // endian_tag
  // 六表：37 string / 6 type / 2 proto / 4 field / 3 method / 2 class
  sem_b_patch_u32(arr, 0x38, 37)
  sem_b_patch_u32(arr, 0x3C, 0x70)
  let type_ids_off = 0x70 + 37 * 4
  sem_b_patch_u32(arr, 0x40, 6)
  sem_b_patch_u32(arr, 0x44, type_ids_off)
  let proto_ids_off = type_ids_off + 6 * 4
  sem_b_patch_u32(arr, 0x48, 2)
  sem_b_patch_u32(arr, 0x4C, proto_ids_off)
  let field_ids_off = proto_ids_off + 2 * 12
  sem_b_patch_u32(arr, 0x50, 4)
  sem_b_patch_u32(arr, 0x54, field_ids_off)
  let method_ids_off = field_ids_off + 4 * 8
  sem_b_patch_u32(arr, 0x58, 3)
  sem_b_patch_u32(arr, 0x5C, method_ids_off)
  let class_defs_off = method_ids_off + 3 * 8
  sem_b_patch_u32(arr, 0x60, 2)
  sem_b_patch_u32(arr, 0x64, class_defs_off)
  // string_ids 占位（稍后补丁）
  for _ in 0..<37 {
    sem_b_u32(arr, 0)
  }
  // type_ids：类型 0..5 → 字符串 0..5
  for i in 0..<6 {
    sem_b_u32(arr, i)
  }
  // proto_ids：0=()V；1=(I)V
  sem_b_u32(arr, 2) // shorty "V"
  sem_b_u32(arr, 2) // return V
  sem_b_u32(arr, 0)
  sem_b_u32(arr, 36) // shorty "VI"
  sem_b_u32(arr, 2) // return V
  sem_b_u32(arr, 0) // parameters_off 稍后补丁
  // field_ids：0=LTest;->fld:I 1=LKind;->VAL:LKind; 2=LTest;->a:I 3=LTest;->b:I
  sem_b_u16(arr, 0)
  sem_b_u16(arr, 3)
  sem_b_u32(arr, 9)
  sem_b_u16(arr, 5)
  sem_b_u16(arr, 5)
  sem_b_u32(arr, 13)
  sem_b_u16(arr, 0)
  sem_b_u16(arr, 3)
  sem_b_u32(arr, 17)
  sem_b_u16(arr, 0)
  sem_b_u16(arr, 3)
  sem_b_u32(arr, 18)
  // method_ids：0=LTest;->m()V 1=LTest;->n(I)V 2=LAnno;->m2()V
  sem_b_u16(arr, 0)
  sem_b_u16(arr, 0)
  sem_b_u32(arr, 10)
  sem_b_u16(arr, 0)
  sem_b_u16(arr, 1)
  sem_b_u32(arr, 11)
  sem_b_u16(arr, 4)
  sem_b_u16(arr, 0)
  sem_b_u32(arr, 12)
  // class_defs：0=LTest;（带注解/静态初值/代码） 1=LAnno;（空）
  sem_b_u32(arr, 0) // class_idx
  sem_b_u32(arr, 1) // public
  sem_b_u32(arr, 1) // superclass
  sem_b_u32(arr, 0) // interfaces_off
  sem_b_u32(arr, 16) // source_file_idx
  sem_b_u32(arr, 0) // annotations_off 稍后补丁
  sem_b_u32(arr, 0) // class_data_off 稍后补丁
  sem_b_u32(arr, 0) // static_values_off 稍后补丁
  sem_b_u32(arr, 4) // class_idx LAnno;
  sem_b_u32(arr, 1)
  sem_b_u32(arr, 1)
  sem_b_u32(arr, 0)
  sem_b_u32(arr, -1) // source_file_idx = NONE
  sem_b_u32(arr, 0)
  sem_b_u32(arr, 0)
  sem_b_u32(arr, 0)
  // type_list（proto1 参数 I）
  let tl_params_off = arr.length()
  sem_b_u32(arr, 1)
  sem_b_u16(arr, 3)
  sem_b_u16(arr, 0)
  sem_b_patch_u32(arr, proto_ids_off + 20, tl_params_off)
  // string data
  for i in 0..<37 {
    let s_off = arr.length()
    sem_b_patch_u32(arr, 0x70 + i * 4, s_off)
    sem_b_str_item(arr, strings[i])
  }
  sem_b_align4(arr)
  // code_item m（全格式指令流 + packed-switch-payload）
  let code_m_off = arr.length()
  sem_b_u16(arr, 9) // registers_size
  sem_b_u16(arr, 0) // ins_size
  sem_b_u16(arr, 3) // outs_size
  sem_b_u16(arr, 0) // tries_size
  sem_b_u32(arr, 0) // debug_info_off
  sem_b_u32(arr, 42) // insns_size
  let words = [
    0x1012, 0x0113, 0xfffe, 0x0215, 0x4060, 0x0319, 0x0001, 0x0418, 0x0708, 0x0506,
    0x0304, 0x0102, 0x65d0, 0x0007, 0x07d8, 0xff08, 0x0228, 0x2132, 0x0005, 0x0038,
    0x0003, 0x0377, 0x0000, 0x0002, 0x206e, 0x0001, 0x0065, 0x001a, 0x000e, 0x001c,
    0x0005, 0x1052, 0x0000, 0x0060, 0x0002, 0x000e, 0x0100, 0x0001, 0x0000, 0x0000,
    0x0002, 0x0000,
  ]
  for w in words {
    sem_b_u16(arr, w)
  }
  // code_item n（参数方法）
  let code_n_off = arr.length()
  sem_b_u16(arr, 1) // registers_size
  sem_b_u16(arr, 1) // ins_size
  sem_b_u16(arr, 0)
  sem_b_u16(arr, 0)
  sem_b_u32(arr, 0)
  sem_b_u32(arr, 2)
  sem_b_u16(arr, 0x0012) // const/4 v0, #+0x0
  sem_b_u16(arr, 0x000e) // return-void
  sem_b_align4(arr)
  // 注解条目 A1：LAnno; RUNTIME，16 元素（encoded_value 全类型）
  let ann_a1_off = arr.length()
  sem_b_u8(arr, 1) // VISIBILITY_RUNTIME
  sem_b_uleb(arr, 4) // type LAnno;
  sem_b_uleb(arr, 16) // 元素数
  sem_val_bytes(arr, 19, [0x00, 0xff]) // e0 byte -1
  sem_b_uleb(arr, 20)
  let ann_a1_e1_off = arr.length()
  sem_b_u8(arr, 0x02) // e1 short -2（1 字节最小宽度）
  sem_b_u8(arr, 0xfe)
  sem_val_bytes(arr, 21, [0x03, 0xff]) // e2 char 255（零扩展）
  sem_val_bytes(arr, 22, [0x44, 0xc0, 0x1d, 0xfe]) // e3 int -123456（3 字节）
  sem_val_bytes(arr, 23, [0x06, 0xfe]) // e4 long -2（1 字节最小宽度）
  sem_val_bytes(arr, 24, [0x30, 0x60, 0x40]) // e5 float 3.5（左对齐 2 字节）
  sem_val_bytes(arr, 25, [0x31, 0x02, 0xc0]) // e6 double -2.25（左对齐 2 字节）
  sem_val_bytes(arr, 26, [0x17, 0x0e]) // e7 string "bar"
  sem_val_bytes(arr, 27, [0x18, 0x05]) // e8 type LKind;
  sem_val_bytes(arr, 28, [0x19, 0x00]) // e9 field LTest;->fld:I
  sem_val_bytes(arr, 29, [0x1a, 0x02]) // e10 method LAnno;->m2()V
  sem_val_bytes(arr, 30, [0x1b, 0x01]) // e11 enum LKind;->VAL:LKind;
  sem_val_bytes(arr, 31, [0x1c, 0x03, 0x04, 0x01, 0x1e, 0x3f]) // e12 array{1,null,true}
  sem_val_bytes(arr, 32, [0x1d, 0x04, 0x01, 0x06, 0x17, 0x23]) // e13 嵌套注解
  sem_val_bytes(arr, 33, [0x1e]) // e14 null
  sem_val_bytes(arr, 34, [0x1f]) // e15 boolean false
  // A2：LAnno; BUILD，1 元素 e0=string "foo"
  let ann_a2_off = arr.length()
  sem_b_u8(arr, 0)
  sem_b_uleb(arr, 4)
  sem_b_uleb(arr, 1)
  sem_val_bytes(arr, 19, [0x17, 0x0f])
  // A3：LAnno; SYSTEM，1 元素 e0=int -1
  let ann_a3_off = arr.length()
  sem_b_u8(arr, 2)
  sem_b_uleb(arr, 4)
  sem_b_uleb(arr, 1)
  sem_val_bytes(arr, 19, [0x04, 0xff])
  // A4：LAnno; RUNTIME，1 元素 e0=boolean false
  let ann_a4_off = arr.length()
  sem_b_u8(arr, 1)
  sem_b_uleb(arr, 4)
  sem_b_uleb(arr, 1)
  sem_val_bytes(arr, 19, [0x1f])
  // A5：LAnno; RUNTIME，1 元素 e0=short -2
  let ann_a5_off = arr.length()
  sem_b_u8(arr, 1)
  sem_b_uleb(arr, 4)
  sem_b_uleb(arr, 1)
  sem_val_bytes(arr, 19, [0x02, 0xfe])
  // annotation_set_item × 4 + annotation_set_ref_list
  let ann_s1_off = arr.length()
  sem_b_u32(arr, 1)
  sem_b_u32(arr, ann_a1_off)
  let ann_s2_off = arr.length()
  sem_b_u32(arr, 1)
  sem_b_u32(arr, ann_a2_off)
  let ann_s3_off = arr.length()
  sem_b_u32(arr, 2)
  sem_b_u32(arr, ann_a3_off)
  sem_b_u32(arr, ann_a4_off)
  let ann_s4_off = arr.length()
  sem_b_u32(arr, 1)
  sem_b_u32(arr, ann_a5_off)
  let ann_r1_off = arr.length()
  sem_b_u32(arr, 2) // 两个参数：第二个偏移 0 → 空集
  sem_b_u32(arr, ann_s4_off)
  sem_b_u32(arr, 0)
  // annotation_directory_item：class/field/method/parameter 各 1
  let ann_dir_off = arr.length()
  sem_b_u32(arr, ann_s1_off) // class_annotations_off
  sem_b_u32(arr, 1) // fields_size
  sem_b_u32(arr, 1) // methods_size
  sem_b_u32(arr, 1) // params_size
  sem_b_u32(arr, 2) // field_idx a
  sem_b_u32(arr, ann_s2_off)
  sem_b_u32(arr, 0) // method_idx m
  sem_b_u32(arr, ann_s3_off)
  sem_b_u32(arr, 1) // method_idx n
  sem_b_u32(arr, ann_r1_off)
  // class_data：static=[a,b] instance=[fld] direct=[m] virtual=[n]
  let class_data_off = arr.length()
  sem_b_uleb(arr, 2) // static_fields_size
  sem_b_uleb(arr, 1) // instance_fields_size
  sem_b_uleb(arr, 1) // direct_methods_size
  sem_b_uleb(arr, 1) // virtual_methods_size
  sem_b_uleb(arr, 2) // a = field@2
  sem_b_uleb(arr, 8) // static
  sem_b_uleb(arr, 1) // b = field@3
  sem_b_uleb(arr, 8)
  sem_b_uleb(arr, 0) // fld = field@0
  sem_b_uleb(arr, 1)
  sem_b_uleb(arr, 0) // m = method@0
  sem_b_uleb(arr, 1)
  sem_b_uleb(arr, code_m_off)
  sem_b_uleb(arr, 1) // n = method@1
  sem_b_uleb(arr, 1)
  sem_b_uleb(arr, code_n_off)
  // static_values：仅编码前缀 1 个（a=7，b 缺省为 0）
  let static_values_off = arr.length()
  sem_b_uleb(arr, 1)
  sem_b_u8(arr, 0x04) // VALUE_INT
  sem_b_u8(arr, 0x07)
  // 补丁：class_def 三个偏移
  sem_b_patch_u32(arr, class_defs_off + 20, ann_dir_off)
  sem_b_patch_u32(arr, class_defs_off + 24, class_data_off)
  sem_b_patch_u32(arr, class_defs_off + 28, static_values_off)
  // map_list
  sem_b_align4(arr)
  let map_off = arr.length()
  sem_b_u32(arr, 8)
  let map_items = [
    (0x0000, 1, 0x00),
    (0x0001, 37, 0x70),
    (0x0002, 6, type_ids_off),
    (0x0003, 2, proto_ids_off),
    (0x0004, 4, field_ids_off),
    (0x0005, 3, method_ids_off),
    (0x0006, 2, class_defs_off),
    (0x1000, 1, map_off),
  ]
  for item in map_items {
    sem_b_u16(arr, item.0)
    sem_b_u16(arr, 0)
    sem_b_u32(arr, item.1)
    sem_b_u32(arr, item.2)
  }
  sem_b_patch_u32(arr, 0x34, map_off)
  sem_b_patch_u32(arr, 0x20, arr.length())
  sem_b_fix_checksum(arr)
  SemFixture::{
    arr,
    ann_a1_off,
    ann_a1_e1_off,
    ann_s1_off,
    sv_off: static_values_off,
  }
}

///|
/// fixture → Bytes。
fn sem_fixture_bytes(fx : SemFixture) -> Bytes {
  Bytes::from_array(fx.arr)
}

///|
/// L2 真实样本（自建受控）：AnnoSample.java（WP-2 编写，覆盖注解全类型值与静态初值）
/// 经 javac 21 --release 8 + d8（Android build-tools 35.0.0）生成的 classes.dex
/// （4264 字节，DEX 035）。SHA-256=
/// 16dbf2d6cb0c56a09312af1a1d22ef955fa74c7873a95d326124b4751bc52d0d。

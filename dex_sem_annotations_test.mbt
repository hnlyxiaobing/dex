  )
  sem_check_eq(
    dir.parameter_annotations[0].parameters[0].annotations.length(),
    1,
    msg="参数 0 有注解",
  )
  sem_check_eq(
    dir.parameter_annotations[0].parameters[1].annotations.length(),
    0,
    msg="参数 1 偏移 0 → 空集",
  )
  // 注解类型与可见性
  let a1 = dir.class_annotations.annotations[0]
  sem_check(
    a1.visibility is @dex.AnnotationVisibility::VisibilityRuntime,
    msg="RUNTIME",
  )
  sem_check_eq(a1.annotation.type_descriptor, "LAnno;", msg="类注解类型")
  let a2 = dir.field_annotations[0].annotations.annotations[0]
  sem_check(
    a2.visibility is @dex.AnnotationVisibility::VisibilityBuild,
    msg="BUILD",
  )
  let a3 = dir.method_annotations[0].annotations.annotations[0]
  sem_check(
    a3.visibility is @dex.AnnotationVisibility::VisibilitySystem,
    msg="SYSTEM",
  )
  sem_check_eq(a3.annotation.elements[0].name, "e0")
}

///|
/// 程序化 fixture：encoded_value 全类型（含 VALUE_FIELD/METHOD/ENUM/NULL 与
/// 最小宽度编码：short/long 1 字节、int 3 字节、float/double 左对齐 2 字节）。
test "sem annotations: encoded_value 全类型解码" {
  let fx = sem_build_dex()
  let dir = match @dex.class_annotations(sem_fixture_bytes(fx), 0) {
    Some(d) => d
    None => fail("class_annotations 应返回 Some")
  }
  let elems = dir.class_annotations.annotations[0].annotation.elements
  sem_check_eq(elems.length(), 16, msg="16 个元素")
  sem_check_eq(elems[0].name, "e0")
  match elems[0].value {
    @dex.EncodedValue::ValueByte(x) => sem_check_eq(x, -1, msg="e0 byte")
    _ => fail("e0 应为 ValueByte")
  }
  sem_check_eq(elems[1].name, "e1")
  match elems[1].value {
    @dex.EncodedValue::ValueShort(x) =>
      sem_check_eq(x, -2, msg="e1 short 1 字节符号扩展")
    _ => fail("e1 应为 ValueShort")
  }
  match elems[2].value {
    @dex.EncodedValue::ValueChar(x) =>
      sem_check_eq(x, 255, msg="e2 char 零扩展")
    _ => fail("e2 应为 ValueChar")
  }
  match elems[3].value {
    @dex.EncodedValue::ValueInt(x) =>
      sem_check_eq(x, -123456, msg="e3 int 3 字节")
    _ => fail("e3 应为 ValueInt")
  }
  match elems[4].value {
    @dex.EncodedValue::ValueLong(x) =>
      sem_check_eq(x, -2L, msg="e4 long 1 字节")
    _ => fail("e4 应为 ValueLong")
  }
  match elems[5].value {
    @dex.EncodedValue::ValueFloat(x) =>
      sem_check_eq(x, 3.5, msg="e5 float 左对齐")
    _ => fail("e5 应为 ValueFloat")
  }
  match elems[6].value {
    @dex.EncodedValue::ValueDouble(x) =>
      sem_check_eq(x, -2.25, msg="e6 double 左对齐")
    _ => fail("e6 应为 ValueDouble")
  }
  match elems[7].value {
    @dex.EncodedValue::ValueString(x) => sem_check_eq(x, "bar", msg="e7 string")
    _ => fail("e7 应为 ValueString")
  }
  match elems[8].value {
    @dex.EncodedValue::ValueType(x) => sem_check_eq(x, "LKind;", msg="e8 type")
    _ => fail("e8 应为 ValueType")
  }
  match elems[9].value {
    @dex.EncodedValue::ValueField(x) =>
      sem_check_eq(x, "LTest;->fld:I", msg="e9 field")
    _ => fail("e9 应为 ValueField")
  }
  match elems[10].value {
    @dex.EncodedValue::ValueMethod(x) =>
      sem_check_eq(x, "LAnno;->m2()V", msg="e10 method")
    _ => fail("e10 应为 ValueMethod")
  }
  match elems[11].value {
    @dex.EncodedValue::ValueEnum(x) =>
      sem_check_eq(x, "LKind;->VAL:LKind;", msg="e11 enum")
    _ => fail("e11 应为 ValueEnum")
  }
  match elems[14].value {
    @dex.EncodedValue::ValueNull => ()
    _ => fail("e14 应为 ValueNull")
  }
  match elems[15].value {
    @dex.EncodedValue::ValueBoolean(x) =>
      sem_check_eq(x, false, msg="e15 boolean false（arg=0）")
    _ => fail("e15 应为 ValueBoolean")
  }
}

///|
/// 程序化 fixture：数组（含 NULL/BOOL 元素）与嵌套注解（VALUE_ANNOTATION）。
test "sem annotations: 嵌套注解与数组" {
  let fx = sem_build_dex()
  let dir = match @dex.class_annotations(sem_fixture_bytes(fx), 0) {
    Some(d) => d
    None => fail("class_annotations 应返回 Some")
  }
  let elems = dir.class_annotations.annotations[0].annotation.elements
  match elems[12].value {
    @dex.EncodedValue::ValueArray(items) => {
      sem_check_eq(items.length(), 3, msg="数组 3 元素")
      match items[0] {
        @dex.EncodedValue::ValueInt(x) => sem_check_eq(x, 1)
        _ => fail("数组[0] 应为 ValueInt")
      }
      match items[1] {
        @dex.EncodedValue::ValueNull => ()
        _ => fail("数组[1] 应为 ValueNull")
      }
      match items[2] {
        @dex.EncodedValue::ValueBoolean(x) => sem_check_eq(x, true)
        _ => fail("数组[2] 应为 ValueBoolean")
      }
    }
    _ => fail("e12 应为 ValueArray")
  }
  match elems[13].value {
    @dex.EncodedValue::ValueAnnotation(ann) => {
      sem_check_eq(ann.type_descriptor, "LAnno;", msg="嵌套注解类型")
      sem_check_eq(ann.elements.length(), 1, msg="嵌套注解 1 元素")
      sem_check_eq(ann.elements[0].name, "value")
      match ann.elements[0].value {
        @dex.EncodedValue::ValueString(x) => sem_check_eq(x, "x")
        _ => fail("嵌套元素应为 ValueString")
      }
    }
    _ => fail("e13 应为 ValueAnnotation")
  }
}

///|
/// 真实样本（AnnoSample.dex）：LAnnoSample$Target; 类注解 @Meta 全值
/// 与 dexdump -d -a 输出逐值对照。
test "sem annotations: 真实样本 AnnoSample @Meta 类注解全值" {
  let data = sem_fixture_anno_dex()
  let dir = match @dex.class_annotations(data, 3) {
    Some(d) => d
    None => fail("Target 应有注解目录")
  }
  let anns = dir.class_annotations.annotations
  sem_check_eq(anns.length(), 3, msg="Target 3 个类注解")
  sem_check(
    anns[0].visibility is @dex.AnnotationVisibility::VisibilityRuntime,
    msg="RUNTIME",
  )
  sem_check_eq(anns[0].annotation.type_descriptor, "LAnnoSample$Meta;")
  let elems = anns[0].annotation.elements
  sem_check_eq(elems.length(), 13, msg="@Meta 13 元素")
  // 元素按 name_idx 升序（与 dexdump 打印序一致）
  sem_check_eq(elems[0].name, "arr")
  sem_check_eq(elems[1].name, "b")
  sem_check_eq(elems[12].name, "sub")
  match elems[0].value {
    @dex.EncodedValue::ValueArray(items) => {
      sem_check_eq(items.length(), 3, msg="arr={ 1 -2 3 }")
      match items[1] {
        @dex.EncodedValue::ValueInt(x) => sem_check_eq(x, -2)
        _ => fail("arr[1] 应为 int")
      }
    }
    _ => fail("arr 应为 ValueArray")
  }
  match elems[1].value {
    @dex.EncodedValue::ValueByte(x) => sem_check_eq(x, -8, msg="b=-8")
    _ => fail("b 应为 ValueByte")
  }
  match elems[2].value {
    @dex.EncodedValue::ValueChar(x) => sem_check_eq(x, 90, msg="c=90 ('Z')")
    _ => fail("c 应为 ValueChar")
  }
  match elems[3].value {
    @dex.EncodedValue::ValueType(x) =>
      sem_check_eq(x, "Ljava/lang/String;", msg="cls")
    _ => fail("cls 应为 ValueType")
  }
  match elems[4].value {
    @dex.EncodedValue::ValueDouble(x) => sem_check_eq(x, -2.25, msg="d=-2.25")
    _ => fail("d 应为 ValueDouble")
  }
  match elems[5].value {
    @dex.EncodedValue::ValueFloat(x) => sem_check_eq(x, 3.5, msg="f=3.5")
    _ => fail("f 应为 ValueFloat")
  }
  match elems[6].value {
    @dex.EncodedValue::ValueBoolean(x) => sem_check_eq(x, true, msg="flag=true")
    _ => fail("flag 应为 ValueBoolean")
  }
  match elems[7].value {
    @dex.EncodedValue::ValueInt(x) => sem_check_eq(x, -123456, msg="i=-123456")
    _ => fail("i 应为 ValueInt")
  }
  match elems[8].value {
    @dex.EncodedValue::ValueEnum(x) =>
      sem_check_eq(
        x,
        "LAnnoSample$Kind;->BETA:LAnnoSample$Kind;",
        msg="kind=BETA",
      )
    _ => fail("kind 应为 ValueEnum")
  }
  match elems[9].value {
    @dex.EncodedValue::ValueLong(x) =>
      sem_check_eq(x, 81985529216486895L, msg="l=0x123456789ABCDEF")
    _ => fail("l 应为 ValueLong")
  }
  match elems[10].value {
    @dex.EncodedValue::ValueShort(x) => sem_check_eq(x, -300, msg="s=-300")
    _ => fail("s 应为 ValueShort")
  }
  match elems[11].value {
    @dex.EncodedValue::ValueString(x) =>
      sem_check_eq(x, "anno-string", msg="str")
    _ => fail("str 应为 ValueString")
  }
  match elems[12].value {
    @dex.EncodedValue::ValueAnnotation(sub) => {
      sem_check_eq(
        sub.type_descriptor,
        "LAnnoSample$Sub;",
        msg="sub 嵌套注解",
      )
      sem_check_eq(sub.elements.length(), 2, msg="sub kind+value")
      sem_check_eq(sub.elements[0].name, "kind")
      match sub.elements[0].value {
        @dex.EncodedValue::ValueEnum(x) =>
          sem_check_eq(x, "LAnnoSample$Kind;->BETA:LAnnoSample$Kind;")
        _ => fail("sub.kind 应为 ValueEnum")
      }
      match sub.elements[1].value {
        @dex.EncodedValue::ValueString(x) => sem_check_eq(x, "nested")
        _ => fail("sub.value 应为 ValueString")
      }
    }
    _ => fail("sub 应为 ValueAnnotation")
  }
  // 其余两个类注解：EnclosingClass（VALUE_TYPE）/ InnerClass（int + string）
  sem_check_eq(
    anns[1].annotation.type_descriptor,
    "Ldalvik/annotation/EnclosingClass;",
  )
  sem_check(anns[1].visibility is @dex.AnnotationVisibility::VisibilitySystem)
  match anns[1].annotation.elements[0].value {
    @dex.EncodedValue::ValueType(x) => sem_check_eq(x, "LAnnoSample;")
    _ => fail("EnclosingClass.value 应为 ValueType")
  }
  sem_check_eq(
    anns[2].annotation.type_descriptor,
    "Ldalvik/annotation/InnerClass;",
  )
  sem_check_eq(anns[2].annotation.elements[0].name, "accessFlags")
  match anns[2].annotation.elements[0].value {
    @dex.EncodedValue::ValueInt(x) => sem_check_eq(x, 9, msg="accessFlags=9")
    _ => fail("accessFlags 应为 ValueInt")
  }
  match anns[2].annotation.elements[1].value {
    @dex.EncodedValue::ValueString(x) =>
      sem_check_eq(x, "Target", msg="InnerClass.name")
    _ => fail("name 应为 ValueString")
  }
}

///|
/// 真实样本（AnnoSample.dex）：AnnotationDefault（默认值数组）、Signature（字符串数组）、
/// Throws（类型数组）、MemberClasses（类型数组）——dexdump -a 对照。
test "sem annotations: 真实样本 AnnoSample 系统注解数组值" {
  let data = sem_fixture_anno_dex()
  // LAnnoSample$Meta;：AnnotationDefault 的 value 为 13 个元素默认值数组
  let meta = match @dex.class_annotations(data, 1) {
    Some(d) => d
    None => fail("Meta 应有注解目录")
  }
  sem_check_eq(
    meta.class_annotations.annotations.length(),
    4,
    msg="Meta 4 个类注解",
  )
  let defaults = meta.class_annotations.annotations[0]
  sem_check_eq(
    defaults.annotation.type_descriptor,
    "Ldalvik/annotation/AnnotationDefault;",
  )
  sem_check(defaults.visibility is @dex.AnnotationVisibility::VisibilitySystem)
  sem_check_eq(defaults.annotation.elements[0].name, "value")
  // AnnotationDefault.value 是**嵌套注解**（VALUE_ANNOTATION）：类型为被注解的
  // 注解接口 LAnnoSample$Meta;，13 个元素即各方法的默认值（dexdump `value=…;` 后
  // 逐个展开 `name=value` 正是嵌套注解显示法）。
  match defaults.annotation.elements[0].value {
    @dex.EncodedValue::ValueAnnotation(meta_defaults) => {
      sem_check_eq(
        meta_defaults.type_descriptor,
        "LAnnoSample$Meta;",
        msg="默认值宿主类型",
      )
      sem_check_eq(
        meta_defaults.elements.length(),
        13,
        msg="13 个默认值（按方法名序）",
      )
      sem_check_eq(meta_defaults.elements[0].name, "arr")
      match meta_defaults.elements[0].value {
        @dex.EncodedValue::ValueArray(inner) =>
          sem_check_eq(inner.length(), 0, msg="arr 默认空数组")
        _ => fail("默认值[0] 应为空数组")
      }
      match meta_defaults.elements[1].value {
        @dex.EncodedValue::ValueByte(x) => sem_check_eq(x, 0, msg="b 默认 0")
        _ => fail("默认值[1] 应为 byte")
      }
      match meta_defaults.elements[8].value {
        @dex.EncodedValue::ValueEnum(x) =>
          sem_check_eq(
            x,
            "LAnnoSample$Kind;->ALPHA:LAnnoSample$Kind;",
            msg="kind 默认 ALPHA",
          )
        _ => fail("默认值[8] 应为 ValueEnum")
      }
      match meta_defaults.elements[12].value {
        @dex.EncodedValue::ValueAnnotation(sub) => {
          sem_check_eq(sub.type_descriptor, "LAnnoSample$Sub;")
          sem_check_eq(
            sub.elements.length(),
            1,
            msg="@Sub(\"none\") 只编码非默认元素",
          )
          match sub.elements[0].value {
            @dex.EncodedValue::ValueString(x) => sem_check_eq(x, "none")
            _ => fail("sub.value 应为 ValueString")
          }
        }
        _ => fail("默认值[12] 应为嵌套注解")
      }
    }
    _ =>
      fail("AnnotationDefault.value 应为 ValueAnnotation（嵌套注解）")
  }
  // LAnnoSample$Kind;：Signature 字符串数组 + InnerClass
  let kind = match @dex.class_annotations(data, 0) {
    Some(d) => d
    None => fail("Kind 应有注解目录")
  }
  let sig = kind.class_annotations.annotations[2]
  sem_check_eq(sig.annotation.type_descriptor, "Ldalvik/annotation/Signature;")
  match sig.annotation.elements[0].value {
    @dex.EncodedValue::ValueArray(items) => {
      sem_check_eq(items.length(), 3, msg="Signature 3 个字符串")
      match items[0] {
        @dex.EncodedValue::ValueString(x) => sem_check_eq(x, "Ljava/lang/Enum<")
        _ => fail("Signature[0] 应为 string")
      }
      match items[2] {
        @dex.EncodedValue::ValueString(x) => sem_check_eq(x, ">;")
        _ => fail("Signature[2] 应为 string")
      }
    }
    _ => fail("Signature.value 应为 ValueArray")
  }
  // LAnnoSample;：MemberClasses 类型数组（dexdump 顺序 Target/Meta/Sub/Kind）
  let root = match @dex.class_annotations(data, 4) {
    Some(d) => d
    None => fail("AnnoSample 应有注解目录")
  }
  let member_ann = root.class_annotations.annotations[0]
  sem_check_eq(
    member_ann.annotation.type_descriptor,
    "Ldalvik/annotation/MemberClasses;",
  )
  match member_ann.annotation.elements[0].value {
    @dex.EncodedValue::ValueArray(items) => {
      sem_check_eq(items.length(), 4, msg="MemberClasses 4 个类型")
      match items[0] {
        @dex.EncodedValue::ValueType(x) =>
          sem_check_eq(x, "LAnnoSample$Target;")
        _ => fail("MemberClasses[0] 应为 type")
      }
      match items[3] {
        @dex.EncodedValue::ValueType(x) => sem_check_eq(x, "LAnnoSample$Kind;")
        _ => fail("MemberClasses[3] 应为 type")
      }
    }
    _ => fail("MemberClasses.value 应为 ValueArray")
  }
  // methodAnno 的 Throws：类型数组
  let target = match @dex.class_annotations(data, 3) {
    Some(d) => d
    None => fail("Target 应有注解目录")
  }
  let throws = target.method_annotations[0].annotations.annotations[1]
  sem_check_eq(throws.annotation.type_descriptor, "Ldalvik/annotation/Throws;")
  match throws.annotation.elements[0].value {
    @dex.EncodedValue::ValueArray(items) =>
      match items[0] {
        @dex.EncodedValue::ValueType(x) =>
          sem_check_eq(x, "Ljava/io/IOException;")
        _ => fail("Throws[0] 应为 type")
      }
    _ => fail("Throws.value 应为 ValueArray")
  }
}

///|
/// 真实样本（AnnoSample.dex）：字段/方法/参数注解目录（field@3、method@21）。
test "sem annotations: 真实样本 AnnoSample 字段/方法/参数注解" {
  let data = sem_fixture_anno_dex()
  let dir = match @dex.class_annotations(data, 3) {
    Some(d) => d
    None => fail("Target 应有注解目录")
  }
  sem_check_eq(dir.field_annotations.length(), 1)
  sem_check_eq(
    dir.field_annotations[0].field_index,
    3,
    msg="fieldAnno = field@3",
  )
  match
    dir.field_annotations[0].annotations.annotations[0].annotation.elements[0].value {
    @dex.EncodedValue::ValueInt(x) => sem_check_eq(x, 7, msg="i=7")
    _ => fail("字段注解值应为 int")
  }
  sem_check_eq(dir.method_annotations.length(), 1)
  sem_check_eq(
    dir.method_annotations[0].method_index,
    21,
    msg="methodAnno = method@21",
  )
  let manns = dir.method_annotations[0].annotations.annotations
  sem_check_eq(manns.length(), 3, msg="Meta/Throws/Deprecated")
  sem_check_eq(manns[0].annotation.type_descriptor, "LAnnoSample$Meta;")
  match manns[0].annotation.elements[0].value {
    @dex.EncodedValue::ValueString(x) => sem_check_eq(x, "on-method")
    _ => fail("Meta.str 应为 string")
  }
  sem_check_eq(manns[2].annotation.type_descriptor, "Ljava/lang/Deprecated;")
  sem_check_eq(
    manns[2].annotation.elements.length(),
    0,
    msg="Deprecated 无元素",
  )
  sem_check(manns[2].visibility is @dex.AnnotationVisibility::VisibilityRuntime)
  sem_check_eq(dir.parameter_annotations.length(), 1)
  sem_check_eq(dir.parameter_annotations[0].method_index, 21)
  let params = dir.parameter_annotations[0].parameters
  sem_check_eq(params.length(), 2, msg="两个形参")
  match params[0].annotations[0].annotation.elements[0].value {
    @dex.EncodedValue::ValueInt(x) => sem_check_eq(x, 1, msg="p1 注解 i=1")
    _ => fail("参数注解值应为 int")
  }
  match params[1].annotations[0].annotation.elements[0].value {
    @dex.EncodedValue::ValueInt(x) => sem_check_eq(x, 2, msg="p2 注解 i=2")
    _ => fail("参数注解值应为 int")
  }
}

///|
/// 真实样本（tvshell-debug.classes.dex）：VALUE_METHOD（EnclosingMethod）、
/// VALUE_NULL（InnerClass.name / MethodParameters.names）与 MethodParameters 数组。
test "sem annotations: 真实样本 tvshell 系统注解" {
  let data = sem_fixture_tvshell_dex()
  let dir = match @dex.class_annotations(data, 0) {
    Some(d) => d
    None => fail("MainActivity$1 应有注解目录")
  }
  let anns = dir.class_annotations.annotations
  sem_check_eq(anns.length(), 2, msg="EnclosingMethod + InnerClass")
  sem_check_eq(
    anns[0].annotation.type_descriptor,
    "Ldalvik/annotation/EnclosingMethod;",
  )
  match anns[0].annotation.elements[0].value {
    @dex.EncodedValue::ValueMethod(x) =>
      sem_check(
        x.contains("onCreate"),
        msg="EnclosingMethod.value=onCreate 方法引用",
      )
    _ => fail("EnclosingMethod.value 应为 ValueMethod（0x1a）")
  }
  sem_check_eq(
    anns[1].annotation.type_descriptor,
    "Ldalvik/annotation/InnerClass;",
  )
  sem_check_eq(anns[1].annotation.elements[0].name, "accessFlags")
  match anns[1].annotation.elements[0].value {
    @dex.EncodedValue::ValueInt(x) => sem_check_eq(x, 0, msg="accessFlags=0")
    _ => fail("accessFlags 应为 ValueInt")
  }
  match anns[1].annotation.elements[1].value {
    @dex.EncodedValue::ValueNull => ()
    _ => fail("InnerClass.name 应为 ValueNull（匿名类）")
  }
  sem_check_eq(dir.method_annotations.length(), 1)
  sem_check_eq(
    dir.method_annotations[0].method_index,
    24,
    msg="<init> = method@24",
  )
  let mp = dir.method_annotations[0].annotations.annotations[0]
  sem_check_eq(
    mp.annotation.type_descriptor,
    "Ldalvik/annotation/MethodParameters;",
  )
  match mp.annotation.elements[0].value {
    @dex.EncodedValue::ValueArray(items) =>
      match items[0] {
        @dex.EncodedValue::ValueInt(x) =>
          sem_check_eq(x, 32784, msg="accessFlags={32784}")
        _ => fail("应为 int")
      }
    _ => fail("accessFlags 应为 ValueArray")
  }
  match mp.annotation.elements[1].value {
    @dex.EncodedValue::ValueArray(items) =>
      match items[0] {
        @dex.EncodedValue::ValueNull => ()
        _ => fail("names[0] 应为 ValueNull")
      }
    _ => fail("names 应为 ValueArray")
  }
}

///|
/// 公开入口：annotation_set / annotation_item 按偏移解码（与目录解码一致）。
test "sem annotations: annotation_set / annotation_item 公开入口" {
  let fx = sem_build_dex()
  let data = sem_fixture_bytes(fx)
  let set = @dex.annotation_set(data, fx.ann_s1_off)
  sem_check_eq(set.annotations.length(), 1, msg="annotation_set 尺寸")
  sem_check_eq(set.annotations[0].annotation.type_descriptor, "LAnno;")
  let item = @dex.annotation_item(data, fx.ann_a1_off)
  sem_check(item.visibility is @dex.AnnotationVisibility::VisibilityRuntime)
  sem_check_eq(
    item.annotation.elements.length(),
    16,
    msg="annotation_item 16 元素",
  )
}

///|
/// 错误路径：坏 visibility、保留 value_type、截断输入、class_index 越界——
/// 一律抛 DexError 而非 panic。
test "sem annotations: 错误路径" {
  let fx = sem_build_dex()
  // 坏 visibility（=3）
  let arr1 = fx.arr.copy()
  arr1[fx.ann_a1_off] = (0x03).to_byte()
  sem_b_fix_checksum(arr1)
  let mut got1 = false
  ignore(@dex.annotation_item(Bytes::from_array(arr1), fx.ann_a1_off)) catch {
    @dex.DexError::BadTableOffset(_, _) => got1 = true
    _ => ()
  }
  sem_check(got1, msg="坏 visibility 应报 BadTableOffset")
  // 保留 value_type（e1 的 format 字节改为 0x01）
  let arr2 = fx.arr.copy()
  arr2[fx.ann_a1_e1_off] = (0x01).to_byte()
  sem_b_fix_checksum(arr2)
  let mut got2 = false
  ignore(@dex.annotation_item(Bytes::from_array(arr2), fx.ann_a1_off)) catch {
    @dex.DexError::BadTableOffset(_, _) => got2 = true
    _ => ()
  }
  sem_check(got2, msg="保留 value_type 应报 BadTableOffset")
  // 截断输入
  let short : Array[Byte] = []
  for i in 0..<300 {
    short.push(fx.arr[i])
  }
  let mut got3 = false
  ignore(@dex.class_annotations(Bytes::from_array(short), 0)) catch {
    _ => got3 = true
  }
  sem_check(got3, msg="截断输入应抛 DexError")
  // class_index 越界
  let data = sem_fixture_bytes(fx)
  let mut got4 = false
  ignore(@dex.class_annotations(data, 2)) catch {
    @dex.DexError::InvalidIndex(kind, idx) => {
      sem_check(kind is @dex.TableKind::ClassDef, msg="InvalidIndex(ClassDef)")
      sem_check_eq(idx, 2)
      got4 = true
    }
    _ => ()
  }
  sem_check(got4, msg="class_index 越界应报 InvalidIndex")
}

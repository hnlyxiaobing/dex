///|
/// 多 dex 结构冒烟：两个 DEX 条目各自可解析；桶 1 含接口/抽象方法（code-less 路径）。
test "smoke dex multi-dex fx-multidex" {
  let d1 = @dex.parse(fixture_fx_multidex_dex())
  let d2 = @dex.parse(fixture_fx_multidex2_dex())
  assert_eq(d1.file_size, 2116, msg="classes.dex 字节数")
  assert_eq(d2.file_size, 1640, msg="classes2.dex 字节数")
  assert_eq(
    d1.classes.length(),
    4,
    msg="桶 1：FxIface/FxMain/FxMultiA/FxMultiB",
  )
  assert_eq(d2.classes.length(), 2, msg="桶 2：FxMultiC/FxMultiD")
  let mut no_code = 0
  for c in d1.classes {
    for m in c.direct_methods {
      match m.code {
        None => no_code = no_code + 1
        Some(_) => ()
      }
    }
    for m in c.virtual_methods {
      match m.code {
        None => no_code = no_code + 1
        Some(_) => ()
      }
    }
  }
  assert_true(
    no_code >= 3,
    msg="FxIface.run/label + FxMultiB.transform 无 code",
  )
}

///|
/// 全方法 opcode 序列覆盖冒烟（WP-4 扩展点）：差分范围是**每个类每个方法**的全量
/// 指令序列，而非旧口径的"首方法 16 条抽样"。桶 1 全方法指令合计远超 16 条。
test "smoke dex 全方法 opcode 序列覆盖" {
  let d = @dex.parse(fixture_fx_multidex_dex())
  let mut total = 0
  let mut coded = 0
  for c in d.classes {
    for m in c.direct_methods {
      match m.code {
        Some(code) => {
          total = total + code.insns.length()
          coded = coded + 1
        }
        None => ()
      }
    }
    for m in c.virtual_methods {
      match m.code {
        Some(code) => {
          total = total + code.insns.length()
          coded = coded + 1
        }
        None => ()
      }
    }
  }
  assert_true(
    coded >= 10,
    msg="桶 1 含 code 方法数（全方法差分范围）",
  )
  assert_true(
    total >= 50,
    msg="桶 1 全方法指令合计远超旧口径 16 条抽样上限",
  )
}

///|
/// xref 黄金常量（WP-4 R3，2026-11-08；wp2-contract §4 冻结格式）：
/// `XREF|<caller_ref>|<offset>|<kind>|<target_ref>`——caller_ref/target_ref =
/// method_ref_name/field_ref_name 渲染（`Lcls;->name(params)ret` / `Lcls;->name:type`）；
/// offset = 十进制 code-unit 偏移；kind 标签固定映射见 fx_xref_kind_label。
/// 排序 = MTH/OPS 黄金同序（class_def 序 → direct_methods → virtual_methods，
/// 经 method_ref_of 桥接）× caller 内 offset 升序；UTF-8 无 BOM、LF、末行带换行；
/// 无访问点 = 0 字节空文件。
/// 三方一致口径（wp2-contract §4 交叉恒等式）：工具侧 dexdump -d 抽取（golden-diff.ps1
/// Get-XrefNorm；dexdump 目标名 `Lcls;.name:(args)ret` 归一为 `Lcls;->name(args)ret`
/// 渲染，归一后校验"须含 ->"）== 解析侧 fx_canon_xref == 本内嵌常量（= 黄金文件逐行，
/// golden-diff.ps1 双向校验）。

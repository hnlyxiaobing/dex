m/mg/motionshell/MainActivity;)V|0x10000\nMTH|Lcom/mg/motionshell/MainActivity$1;|shouldOverrideUrlLoading|(Landroid/webkit/WebView;Landroid/webkit/WebResourceRequest;)Z|0x0001\nCLZ|Lcom/mg/motionshell/MainActivity;\nMTH|Lcom/mg/motionshell/MainActivity;|<init>|()V|0x10001\nMTH|Lcom/mg/motionshell/MainActivity;|hideSystemUi|()V|0x0002\nMTH|Lcom/mg/motionshell/MainActivity;|onCreate|(Landroid/os/Bundle;)V|0x0004\nMTH|Lcom/mg/motionshell/MainActivity;|onDestroy|()V|0x0004\nMTH|Lcom/mg/motionshell/MainActivity;|onKeyDown|(ILandroid/view/KeyEvent;)Z|0x0001\nMTH|Lcom/mg/motionshell/MainActivity;|onWindowFocusChanged|(Z)V|0x0001\nINSMTH|Lcom/mg/motionshell/MainActivity$1;|<init>|(Lcom/mg/motionshell/MainActivity;)V\nINS|0|iput-object\nINS|1|invoke-direct\nINS|2|return-void\n"
}
// GOLDEN-END dex/motionshell.dexparse.norm.txt

///|
/// 无符号十六进制（小写，至少 `min` 位）。
fn fx_hex(v : UInt32, min : Int32) -> String {
  let digits = "0123456789abcdef"
  let mut s = ""
  let mut x = v
  let mut n = 0
  while x != 0U {
    let d = (x & 15U).to_byte().to_int()
    s = digits[d:d + 1].to_owned() + s
    x = x >> 4
    n = n + 1
  }
  while n < min {
    s = "0" + s
    n = n + 1
  }
  if n == 0 {
    s = "0"
  }
  s
}

///|
fn fx_hex8(v : UInt32) -> String {
  fx_hex(v, 8)
}

///|
/// 两个十六进制数字（0..255）。
fn fx_hex2(v : Int32) -> String {
  let digits = "0123456789abcdef"
  let hi = (v >> 4) & 0xF
  let lo = v & 0xF
  digits[hi:hi + 1].to_owned() + digits[lo:lo + 1].to_owned()
}

///|
/// dexdump 的 signature 渲染：前 2 字节 hex + "..." + 后 2 字节 hex。
fn fx_sig_short(sig : Bytes) -> String {
  let n = sig.length()
  if n < 4 {
    ""
  } else {
    fx_hex2(sig[0].to_int()) +
    fx_hex2(sig[1].to_int()) +
    "..." +
    fx_hex2(sig[n - 2].to_int()) +
    fx_hex2(sig[n - 1].to_int())
  }
}

///|
/// magic 字段渲染（与 dexdump 的 `'dex\n035\0'` 一致）。
fn fx_magic(v : @dex.DexVersion) -> String {
  let digits = match v {
    Dex035 => "035"
    Dex037 => "037"
    Dex038 => "038"
    Dex039 => "039"
    Dex040 => "040"
    Dex041 => "041"
    Unknown(_) => "???"
  }
  "'dex\\n\{digits}\\0'"
}

///|
/// dexdump 的 proto 渲染：`(参数串)返回类型`。
fn fx_proto(p : @dex.ProtoId) -> String {
  let mut s = "("
  for x in p.parameters {
    s = s + x
  }
  s + ")" + p.return_type
}

///|
/// 按 dexdump 的顺序找到第一条含指令的方法（class_defs -> direct -> virtual）。
/// 返回 `(method_ref, 是否找到)`。
fn fx_first_coded_method(d : @dex.DexFile) -> (Int32, Bool) {
  let mut ref_idx = -1
  let mut done = false
  for c in d.classes {
    if !done {
      for m in c.direct_methods {
        if !done {
          match m.code {
            Some(code) =>
              if !code.insns.is_empty() {
                ref_idx = fx_find_ref(d, m)
                done = true
              }
            None => ()
          }
        }
      }
    }
    if !done {
      for m in c.virtual_methods {
        if !done {
          match m.code {
            Some(code) =>
              if !code.insns.is_empty() {
                ref_idx = fx_find_ref(d, m)
                done = true
              }
            None => ()
          }
        }
      }
    }
  }
  (ref_idx, done)
}

///|
fn fx_find_ref(d : @dex.DexFile, target : @dex.MethodDef) -> Int32 {
  let mut res = -1
  let mut i = 0
  let n = d.methods.length()
  while i < n {
    let m = d.methods[i]
    if m.class_index == target.class_index &&
      m.name_index == target.name_index &&
      m.proto_index == target.proto_index &&
      res < 0 {
      res = i
    }
    i = i + 1
  }
  res
}

///|
/// dex 解析侧黄金规范化：HDR 子集 + STR + CLZ + MTH + INSMTH/INS。
/// 与 fixtures/golden/dex/<id>.dexparse.norm.txt 同构（该文件由 dexdump 规范化生成）。
fn fx_canon_dex(d : @dex.DexFile) -> String raise @dex.DexError {
  let out : Array[String] = []
  out.push("HDR|magic|\{fx_magic(d.version)}")
  out.push("HDR|checksum|\{fx_hex8(d.checksum)}")
  out.push("HDR|signature|\{fx_sig_short(d.signature)}")
  out.push("HDR|file_size|\{d.file_size}")
  out.push("HDR|header_size|\{d.header_size}")
  out.push("HDR|string_ids_size|\{d.strings.length()}")
  out.push("HDR|type_ids_size|\{d.type_descriptors.length()}")
  out.push("HDR|proto_ids_size|\{d.protos.length()}")
  out.push("HDR|field_ids_size|\{d.fields.length()}")
  out.push("HDR|method_ids_size|\{d.methods.length()}")
  out.push("HDR|class_defs_size|\{d.classes.length()}")
  let mut i = 0
  while i < d.strings.length() {
    out.push("STR|\{i}|\{d.strings[i]}")
    i = i + 1
  }
  // 按类交错（与 dexdump 规范化黄金一致）：CLZ 后紧跟该类的 direct+virtual 方法；
  // access_flags 渲染为 `0x` + 至少 4 位小写 hex（dexdump `access : 0x...` 原样）。
  for c in d.classes {
    out.push("CLZ|\{c.type_descriptor}")
    for m in c.direct_methods {
      out.push(
        "MTH|\{c.type_descriptor}|\{d.strings[m.name_index]}|\{fx_proto(d.protos[m.proto_index])}|0x\{fx_hex(m.access_flags, 4)}",
      )
    }
    for m in c.virtual_methods {
      out.push(
        "MTH|\{c.type_descriptor}|\{d.strings[m.name_index]}|\{fx_proto(d.protos[m.proto_index])}|0x\{fx_hex(m.access_flags, 4)}",
      )
    }
  }
  let m_ref = fx_first_coded_method(d)
  if m_ref.1 {
    let ref_idx = m_ref.0
    let md = d.methods[ref_idx]
    out.push(
      "INSMTH|\{d.type_descriptors[md.class_index]}|\{d.strings[md.name_index]}|\{fx_proto(d.protos[md.proto_index])}",
    )
    match d.code(ref_idx) {
      Some(code) => {
        let mut k = 0
        while k < code.insns.length() && k < 16 {
          out.push("INS|\{k}|\{code.insns[k].mnemonic}")
          k = k + 1
        }
      }
      None => ()
    }
  }
  let mut s = ""
  let mut first = true
  for l in out {
    if first {
      first = false
    } else {
      s = s + "\n"
    }
    s = s + l
  }
  s + "\n"
}

///|
/// R2 主控修复记录（2026-11-07）：`parse_class_data` 的 direct/virtual（及 static/instance）
/// 分段索引复位缺陷已修复（AOSP libdex 行为）；本用例由 KNOWN-DEFECT 钉死用例改为
/// 真实黄金差分：@dex.parse 输出规范化后必须与 dexdump 黄金逐字段一致。
test "golden dex tvshell-debug" {
  let d = @dex.parse(fixture_tvshell_dex())
  assert_eq(
    fx_canon_dex(d),
    golden_tvshell_dexparse(),
    msg="tvshell-debug 真实 DEX 解析输出 == dexdump 规范化黄金",
  )
}

///|
/// 真实样本冒烟：真实 DEX 必须可解析且结构字段合理。
test "smoke dex real classes.dex tvshell-debug" {
  let d = @dex.parse(fixture_tvshell_dex())
  assert_eq(d.file_size, 4368, msg="tvshell-debug dex 字节数")
  assert_eq(d.classes.length(), 4, msg="class_defs_size=4")
  assert_eq(d.methods.length(), 43, msg="method_ids_size=43")
}

///|
test "smoke dex real classes.dex motionshell" {
  let d = @dex.parse(fixture_motionshell_dex())
  assert_eq(d.file_size, 3148, msg="motionshell dex 字节数")
  assert_true(d.classes.length() > 0, msg="至少 1 个 class_def")
}

///|
test "golden dex motionshell" {
  let d = @dex.parse(fixture_motionshell_dex())
  assert_eq(
    fx_canon_dex(d),
    golden_motionshell_dexparse(),
    msg="motionshell 真实 DEX 解析输出 == dexdump 规范化黄金",
  )
}

